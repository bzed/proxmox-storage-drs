#!/usr/bin/make -f
# SPDX-FileCopyrightText: 2026 Bernd Zeimetz <bernd@bzed.de>
# SPDX-License-Identifier: AGPL-3.0-or-later

export DH_VERBOSE = 1
export PYBUILD_NAME = proxmox-storage-drs

%:
	dh $@ --buildsystem=pybuild

# The manpage is generated from Markdown, so it is built here rather than
# committed.  The three PDFs (plan, internals, manual) are not rebuilt: each
# is a committed, reproducible artefact whose freshness `make check` and CI
# already enforce, and re-running LuaLaTeX in the build chroot would pull in
# the whole of TeX Live three times to produce byte-identical files.
# override_dh_auto_test verifies them instead of trusting them.
override_dh_auto_build:
	dh_auto_build
ifeq (,$(filter nodoc,$(DEB_BUILD_OPTIONS) $(DEB_BUILD_PROFILES)))
	$(MAKE) man
endif

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	dh_auto_test
	# Every shipped PDF must be the rendering of its shipped Markdown.  This is
	# the same assertion `make docs-check` makes, written out so that it needs
	# no document toolchain in the chroot and cannot degrade to a warning.
	sha256sum --check docs/IMPLEMENTATION_PLAN.pdf.sha256
	sha256sum --check docs/internals.pdf.sha256
	sha256sum --check docs/pve-storage-drs-manual.pdf.sha256
endif

# The Markdown sources of the manual, the internals guide and the
# specification are shipped beside the three PDFs (debian/*.docs): a PVE node
# has no GUI and often no way to get a PDF off it, so `less
# /usr/share/doc/pve-storage-drs/manual/20-verifying-metrics.md` has to work on
# the machine that actually has the problem.  Leaving them uncompressed is the
# point -- a directory of mixed .md and .md.gz (dh_compress's 4 kB threshold
# splits these files almost exactly in half) is not something you can grep
# without thinking about it first.
#
# .pdf for the same reason and one more: dh_compress does compress them by
# default, and a `.pdf.gz` is not openable by any PDF viewer -- so the one
# audience the PDFs exist for has to know to gunzip first.  The compression
# buys nothing either way, since a PDF's content streams are already deflated.
override_dh_compress:
	dh_compress -X.md -X.pdf

override_dh_auto_clean:
	dh_auto_clean
	rm -f man/pve-storage-drs.1
	rm -rf docs/.build .pytest_cache .mypy_cache
